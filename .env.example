# Application
APP_NAME=VOXAORA
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-very-long-random-secret-key
APP_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
DATABASE_URL=postgresql+asyncpg://voxaora:voxaora_pass@localhost:5432/voxaora_db
DATABASE_SYNC_URL=postgresql://voxaora:voxaora_pass@localhost:5432/voxaora_db

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Picovoice (wake word)
PICOVOICE_ACCESS_KEY=your-picovoice-access-key

# Storage (S3-compatible)
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET_NAME=voxaora-assets
S3_REGION=us-east-1

# Payment (mock by default)
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Push Notifications (FCM)
FCM_SERVER_KEY=your-fcm-server-key

# Geo
DEFAULT_CITY=Riyadh
DEFAULT_COUNTRY=SA
DEFAULT_CURRENCY=SAR
DEFAULT_LANGUAGE=ar

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Debug
DEBUG=true
LOG_LEVEL=INFO
